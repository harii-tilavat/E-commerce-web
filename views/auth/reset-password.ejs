<%- include('../includes/head.ejs') %>
</head>
<body class="min-h-screen">
    <%- include('../includes/navigation.ejs') %>
    <main class="max-w-screen-xl mx-auto px-6 py-12 fade-in">
        <div class="max-w-md mx-auto">
            <div class="text-center mb-8">
                <span class="inline-flex items-center gap-1.5 text-[11px] font-semibold uppercase tracking-widest text-indigo-300 bg-indigo-500/10 border border-indigo-400/20 px-2.5 py-1 rounded-full mb-4">
                    <span class="w-1.5 h-1.5 rounded-full bg-indigo-400"></span>
                    Password recovery
                </span>
                <h1 class="text-white text-3xl font-extrabold tracking-tight">Reset your <span class="text-gradient">password</span></h1>
                <p class="text-slate-400 text-sm mt-2">Enter your email and we'll send you a secure link to reset your password.</p>
            </div>

            <div class="glass rounded-2xl border border-slate-800/60 p-6 sm:p-8 shadow-2xl">
                <% if (errorMessage) { %>
                    <div class="mb-5 flex items-start gap-2 rounded-lg border border-red-500/30 bg-red-500/10 px-4 py-3 text-sm text-red-300">
                        <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 mt-0.5 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M12 9v2m0 4h.01M10.29 3.86L1.82 18a2 2 0 001.71 3h16.94a2 2 0 001.71-3L13.71 3.86a2 2 0 00-3.42 0z"/></svg>
                        <span><%= errorMessage %></span>
                    </div>
                <% } %>
                <form action="/reset-password" method="POST" class="flex flex-col gap-5">
                    <div>
                        <label for="email" class="block text-slate-300 text-xs font-semibold uppercase tracking-wider mb-2">E-Mail</label>
                        <div class="relative">
                            <span class="absolute left-4 top-1/2 -translate-y-1/2 text-slate-500 pointer-events-none">
                                <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
                            </span>
                            <input type="email" name="email" id="email"
                                placeholder="you@example.com"
                                class="input !pl-10"
                                required>
                        </div>
                        <p class="text-xs text-slate-500 mt-2">We'll send reset instructions to this address.</p>
                    </div>

                    <button type="submit" class="btn btn-primary !py-3 w-full">
                        <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
                        Send reset link
                    </button>
                </form>

                <div class="relative my-6">
                    <div class="absolute inset-0 flex items-center"><div class="w-full border-t border-slate-800/60"></div></div>
                    <div class="relative flex justify-center"><span class="px-3 text-xs uppercase tracking-widest text-slate-500 bg-navy-900">or</span></div>
                </div>

                <p class="text-center text-sm text-slate-400">
                    Remembered your password?
                    <a href="/login" class="font-semibold text-indigo-300 hover:text-indigo-200 transition-colors">Back to sign in</a>
                </p>
            </div>
        </div>
    </main>
    <%- include('../includes/end.ejs') %>
