<%- include('../includes/head.ejs') %>
</head>
<body class="min-h-screen">
    <%- include('../includes/navigation.ejs') %>
    <main class="max-w-screen-xl mx-auto px-6 py-10 fade-in">
        <section class="relative overflow-hidden rounded-3xl border border-slate-800/70 bg-gradient-to-br from-navy-800/80 via-navy-850/60 to-navy-900/40 px-8 py-12 mb-10">
            <div class="absolute -top-24 -right-20 w-80 h-80 rounded-full bg-indigo-500/20 blur-3xl"></div>
            <div class="absolute -bottom-20 -left-10 w-72 h-72 rounded-full bg-cyan-400/10 blur-3xl"></div>
            <div class="relative max-w-2xl">
                <span class="inline-flex items-center gap-2 text-xs font-semibold uppercase tracking-widest text-indigo-300 bg-indigo-500/10 border border-indigo-400/20 px-3 py-1 rounded-full mb-4">
                    <span class="w-1.5 h-1.5 rounded-full bg-indigo-400 animate-pulse"></span> New arrivals
                </span>
                <h1 class="text-4xl sm:text-5xl font-extrabold tracking-tight text-white leading-tight">
                    Featured <span class="text-gradient">Products</span>
                </h1>
                <p class="text-slate-400 text-base mt-3 max-w-md">Hand-picked products, carefully curated. Browse the latest collection and find something you'll love.</p>
            </div>
        </section>

        <div class="flex items-end justify-between mb-6">
            <div>
                <h2 class="text-slate-100 text-xl font-bold">Latest drops</h2>
                <p class="text-slate-500 text-sm mt-0.5">Fresh picks from the catalog</p>
            </div>
        </div>

        <% if (prods.length > 0) { %>
            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-6">
                <% for (let product of prods) { %>
                    <article class="card-hover glass rounded-2xl overflow-hidden flex flex-col group">
                        <div class="aspect-[4/3] bg-navy-700 overflow-hidden relative">
                            <img src="<%= product.imageUrl %>" alt="<%= product.title %>" class="w-full h-full object-cover group-hover:scale-[1.04] transition-transform duration-500">
                            <div class="absolute inset-0 bg-gradient-to-t from-navy-950/70 via-transparent to-transparent opacity-60"></div>
                        </div>
                        <div class="p-4 flex-1 flex flex-col">
                            <h3 class="text-slate-100 font-semibold text-sm leading-snug line-clamp-1"><%= product.title %></h3>
                            <p class="text-slate-400 text-xs leading-relaxed line-clamp-2 mt-1.5"><%= product.description %></p>
                            <div class="mt-auto pt-4 flex items-center justify-between gap-3">
                                <div>
                                    <p class="text-[11px] uppercase tracking-wider text-slate-500 font-semibold">Price</p>
                                    <p class="text-white font-bold text-lg leading-tight">$<%= product.price %></p>
                                </div>
                            </div>
                        </div>
                        <div class="px-4 pb-4">
                            <%- include('../includes/add-to-cart.ejs', {product: product}) %>
                        </div>
                    </article>
                <% } %>
            </div>
        <% } else { %>
            <div class="flex flex-col items-center justify-center min-h-[50vh] text-center glass rounded-3xl py-20 px-8">
                <div class="w-16 h-16 rounded-2xl bg-indigo-500/10 border border-indigo-400/20 flex items-center justify-center text-3xl mb-5">🛍️</div>
                <h2 class="text-slate-100 text-2xl font-bold mb-2">No Products Found</h2>
                <p class="text-slate-500 text-sm max-w-xs">Check back later or add some products to get started.</p>
            </div>
        <% } %>
    </main>
    <%- include('../includes/end.ejs') %>
