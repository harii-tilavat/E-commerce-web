<%- include('../includes/head.ejs') %>
</head>
<body class="min-h-screen">
    <%- include('../includes/navigation.ejs') %>
    <main class="max-w-screen-xl mx-auto px-6 py-10 fade-in">
        <a href="/products" class="inline-flex items-center gap-2 text-slate-400 hover:text-white text-sm mb-6 transition-colors group">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 group-hover:-translate-x-0.5 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7"/></svg>
            Back to Products
        </a>

        <div class="grid md:grid-cols-2 gap-8 max-w-5xl">
            <div class="glass rounded-3xl overflow-hidden shadow-2xl border border-slate-800/60">
                <div class="aspect-square bg-navy-700 overflow-hidden relative">
                    <img src="<%= product.imageUrl %>" alt="<%= product.title %>" class="w-full h-full object-cover">
                    <div class="absolute inset-0 bg-gradient-to-t from-navy-950/40 via-transparent to-transparent"></div>
                </div>
            </div>

            <div class="flex flex-col">
                <span class="inline-flex items-center gap-2 self-start text-[11px] font-semibold uppercase tracking-widest text-emerald-300 bg-emerald-500/10 border border-emerald-400/20 px-2.5 py-1 rounded-full mb-4">
                    <span class="w-1.5 h-1.5 rounded-full bg-emerald-400"></span> In stock
                </span>
                <h1 class="text-white text-3xl sm:text-4xl font-extrabold tracking-tight leading-tight"><%= product.title %></h1>
                <div class="flex items-baseline gap-3 mt-4">
                    <p class="text-white text-4xl font-extrabold tracking-tight">$<%= product.price %></p>
                    <span class="text-slate-500 text-sm">incl. taxes</span>
                </div>
                <p class="text-slate-400 text-sm leading-relaxed mt-6"><%= product.description %></p>

                <div class="mt-8 pt-6 border-t border-slate-800/70">
                    <%- include('../includes/add-to-cart.ejs') %>
                </div>

                <div class="grid grid-cols-3 gap-3 mt-6">
                    <div class="glass rounded-xl p-3 text-center">
                        <p class="text-[10px] uppercase tracking-widest text-slate-500 font-semibold">Shipping</p>
                        <p class="text-slate-200 text-xs font-semibold mt-1">Free</p>
                    </div>
                    <div class="glass rounded-xl p-3 text-center">
                        <p class="text-[10px] uppercase tracking-widest text-slate-500 font-semibold">Returns</p>
                        <p class="text-slate-200 text-xs font-semibold mt-1">30 days</p>
                    </div>
                    <div class="glass rounded-xl p-3 text-center">
                        <p class="text-[10px] uppercase tracking-widest text-slate-500 font-semibold">Warranty</p>
                        <p class="text-slate-200 text-xs font-semibold mt-1">1 year</p>
                    </div>
                </div>
            </div>
        </div>
    </main>
    <%- include('../includes/end.ejs') %>
