<%- include('../includes/head.ejs') %>
</head>
<body class="min-h-screen">
    <%- include('../includes/navigation.ejs') %>
    <main class="max-w-screen-xl mx-auto px-6 py-10 fade-in">
        <div class="mb-8">
            <h1 class="text-white text-3xl font-extrabold tracking-tight">Shopping Cart</h1>
            <p class="text-slate-400 text-sm mt-1">Review your items before checkout</p>
        </div>

        <% if (products.length > 0) { %>
            <div class="grid lg:grid-cols-3 gap-6 max-w-5xl">
                <div class="lg:col-span-2 glass rounded-2xl border border-slate-800/60 overflow-hidden">
                    <div class="px-5 py-3.5 border-b border-slate-800/70 flex items-center justify-between">
                        <p class="text-xs font-semibold uppercase tracking-widest text-slate-400">Items (<%= products.length %>)</p>
                    </div>
                    <ul class="divide-y divide-slate-800/70 list-none m-0 p-0">
                        <% products.forEach(p => { %>
                            <li class="px-5 py-4 flex items-center gap-4 hover:bg-slate-800/30 transition-colors">
                                <div class="w-11 h-11 rounded-xl bg-gradient-to-br from-indigo-500/30 to-cyan-400/20 border border-slate-700/60 flex items-center justify-center text-slate-200 font-semibold text-sm shrink-0">
                                    <%= p.productId.title.charAt(0).toUpperCase() %>
                                </div>
                                <div class="flex-1 min-w-0">
                                    <p class="text-slate-100 font-semibold text-sm truncate"><%= p.productId.title %></p>
                                    <p class="text-slate-500 text-xs mt-0.5">Quantity: <span class="text-slate-300 font-medium"><%= p.quantity %></span></p>
                                </div>
                                <form action="/cart-delete-item" method="POST" style="display:inline">
                                    <input type="hidden" value="<%= p.productId._id %>" name="productId">
                                    <button type="submit" class="btn btn-danger !py-1.5 !px-3 !text-xs">
                                        <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6M1 7h22M9 7V4a1 1 0 011-1h4a1 1 0 011 1v3"/></svg>
                                        Remove
                                    </button>
                                </form>
                            </li>
                        <% }) %>
                    </ul>
                </div>

                <aside class="glass rounded-2xl border border-slate-800/60 p-6 h-fit sticky top-24">
                    <p class="text-xs font-semibold uppercase tracking-widest text-slate-400 mb-4">Order summary</p>
                    <div class="flex items-center justify-between py-2 text-sm">
                        <span class="text-slate-400">Items</span>
                        <span class="text-slate-100 font-medium"><%= products.length %></span>
                    </div>
                    <div class="flex items-center justify-between py-2 text-sm">
                        <span class="text-slate-400">Shipping</span>
                        <span class="text-emerald-400 font-medium">Free</span>
                    </div>
                    <div class="border-t border-slate-800/70 my-3"></div>
                    <div class="flex items-center justify-between py-2">
                        <span class="text-slate-300 font-semibold">Ready to ship</span>
                        <span class="text-white font-bold">✓</span>
                    </div>
                    <form action="/create-order" method="POST" class="mt-4">
                        <button type="submit" class="btn btn-primary w-full !py-3">
                            Place Order
                            <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3"/></svg>
                        </button>
                    </form>
                </aside>
            </div>
        <% } else { %>
            <div class="flex flex-col items-center justify-center min-h-[55vh] text-center glass rounded-3xl py-20 px-8 max-w-2xl mx-auto">
                <div class="w-16 h-16 rounded-2xl bg-indigo-500/10 border border-indigo-400/20 flex items-center justify-center text-3xl mb-5">🛒</div>
                <h2 class="text-slate-100 text-2xl font-bold mb-2">Your cart is empty</h2>
                <p class="text-slate-500 text-sm mb-6">Add some products to get started.</p>
                <a href="/" class="btn btn-primary">Browse Products</a>
            </div>
        <% } %>
    </main>
    <%- include('../includes/end.ejs') %>
