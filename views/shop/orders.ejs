<%- include('../includes/head.ejs') %>
</head>
<body class="min-h-screen">
    <%- include('../includes/navigation.ejs') %>
    <main class="max-w-screen-xl mx-auto px-6 py-10 fade-in">
        <div class="mb-8">
            <h1 class="text-white text-3xl font-extrabold tracking-tight">My Orders</h1>
            <p class="text-slate-400 text-sm mt-1">Track your completed purchases</p>
        </div>

        <% if (orders.length <= 0) { %>
            <div class="flex flex-col items-center justify-center min-h-[55vh] text-center glass rounded-3xl py-20 px-8 max-w-2xl mx-auto">
                <div class="w-16 h-16 rounded-2xl bg-indigo-500/10 border border-indigo-400/20 flex items-center justify-center text-3xl mb-5">📦</div>
                <h2 class="text-slate-100 text-2xl font-bold mb-2">No orders yet</h2>
                <p class="text-slate-500 text-sm">Your completed orders will appear here.</p>
            </div>
        <% } else { %>
            <div class="max-w-4xl flex flex-col gap-4">
                <% orders.forEach(order => { %>
                    <div class="glass rounded-2xl border border-slate-800/60 overflow-hidden hover:border-slate-700 transition-colors">
                        <div class="px-5 py-4 border-b border-slate-800/70 flex items-center justify-between flex-wrap gap-3">
                            <div class="flex items-center gap-3">
                                <div class="w-9 h-9 rounded-lg bg-indigo-500/15 border border-indigo-400/20 flex items-center justify-center text-indigo-300">
                                    <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4"/></svg>
                                </div>
                                <div>
                                    <p class="text-[11px] uppercase tracking-wider text-slate-500 font-semibold">Order</p>
                                    <span class="text-slate-100 text-sm font-semibold font-mono">#<%= order._id %></span>
                                </div>
                            </div>
                            <span class="inline-flex items-center gap-1.5 bg-emerald-500/10 text-emerald-300 text-xs font-semibold px-3 py-1 rounded-full border border-emerald-400/20">
                                <span class="w-1.5 h-1.5 rounded-full bg-emerald-400"></span>
                                Completed
                            </span>
                        </div>
                        <div class="overflow-x-auto">
                            <table class="w-full text-sm">
                                <thead>
                                    <tr class="text-left text-[11px] uppercase tracking-widest text-slate-500">
                                        <th class="px-5 py-2.5 font-semibold">Product</th>
                                        <th class="px-5 py-2.5 font-semibold text-right">Qty</th>
                                    </tr>
                                </thead>
                                <tbody class="divide-y divide-slate-800/70">
                                    <% order.products.forEach(item => { %>
                                        <tr class="hover:bg-slate-800/30 transition-colors">
                                            <td class="px-5 py-3 text-slate-200"><%= item.product.title %></td>
                                            <td class="px-5 py-3 text-right">
                                                <span class="inline-flex items-center justify-center min-w-[2rem] text-slate-300 text-xs font-mono bg-slate-800/70 border border-slate-700/60 px-2 py-0.5 rounded-md">× <%= item.quantity %></span>
                                            </td>
                                        </tr>
                                    <% }); %>
                                </tbody>
                            </table>
                        </div>
                    </div>
                <% }); %>
            </div>
        <% } %>
    </main>
    <%- include('../includes/end.ejs') %>
