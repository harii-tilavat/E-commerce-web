{
  "name": "nodejs-complete-guide",
  "version": "1.0.0",
  "description": "Complete Node.js Guide",
  "main": "dist/app.js",
  "type": "module",
  "scripts": {
    "test": "NODE_ENV=test JWT_SECRET=jwt_secret mocha --recursive --import=tsx \"test/**/*.spec.ts\"",
    "start": "tsx watch src/app.ts",
    "start-server": "tsx src/app.ts",
    "build": "tsc -p tsconfig.build.json",
    "start-prod": "node dist/app.js",
    "typecheck": "tsc --noEmit"
  },
  "author": "Maximilian Schwarzmüller",
  "license": "ISC",
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/chai": "^5.2.3",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/mocha": "^10.0.10",
    "@types/multer": "^2.1.0",
    "@types/node": "^25.6.0",
    "@types/pdfkit": "^0.17.6",
    "@types/sinon": "^21.0.1",
    "chai": "^6.2.2",
    "mocha": "^11.7.5",
    "nodemon": "^1.18.3",
    "tsx": "^4.21.0",
    "typescript": "^6.0.3"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.5",
    "dotenv": "^17.4.2",
    "express": "^4.16.3",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^9.5.0",
    "multer": "^2.1.1",
    "pdfkit": "^0.18.0",
    "sinon": "^21.1.2",
    "zod": "^4.3.6"
  }
}
